{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "tests",
    "outDir": ".test-build",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"]
}
